// Hand-written types for the Emscripten loader generated by wasm/build.sh.
export interface HunspellModule {
  FS: {
    mkdirTree(path: string): void;
    writeFile(path: string, data: Uint8Array): void;
    unlink(path: string): void;
  };
  cwrap(name: string, returnType: 'number' | null, argTypes: ('number' | 'string')[]): (...args: (number | string)[]) => number;
  UTF8ToString(ptr: number): string;
}

export interface HunspellModuleOptions {
  locateFile?: (path: string, scriptDirectory: string) => string;
  wasmBinary?: ArrayBuffer | Uint8Array;
}

declare function createHunspellModule(options?: HunspellModuleOptions): Promise<HunspellModule>;
export default createHunspellModule;
