{
  "name": "spell-checking-prototype",
  "private": true,
  "version": "0.1.0",
  "description": "Prototype of the Agent Desktop composer assistance layer (PER #60254, #60145)",
  "type": "module",
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "predev": "node scripts/fetch-dicts.ts",
    "dev": "vite",
    "prebuild": "node scripts/fetch-dicts.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/fetch-dicts.ts",
    "test": "vitest run && npm run test:py",
    "test:py": "uv run --project server --locked pytest server/tests -q",
    "test:watch": "vitest",
    "fetch-dicts": "node scripts/fetch-dicts.ts",
    "lists:ayaspell": "node --import ./eval/register.ts scripts/extract-ayaspell-rep.ts",
    "build:wasm": "bash wasm/build.sh",
    "ad-loader": "node dev/ad-loader/serve.ts",
    "server": "uv run --project server --locked python -m assist",
    "demo": "node scripts/demo.ts",
    "eval": "node --import ./eval/register.ts eval/cli/eval.ts",
    "eval:check": "node --import ./eval/register.ts eval/cli/eval.ts --check",
    "eval:baseline": "node --import ./eval/register.ts eval/cli/eval.ts --baseline",
    "eval:build": "node --import ./eval/register.ts eval/cli/build.ts",
    "eval:manifest": "node --import ./eval/register.ts eval/cli/manifest.ts",
    "eval:words": "node --import ./eval/register.ts eval/cli/words.ts",
    "eval:inject": "node --import ./eval/register.ts eval/cli/inject.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "dictionary-en": "^4.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
