{
  "name": "spell-checking-prototype",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "description": "Demo of LLM spell checking, auto-correct, inline completion and polish for an agent message field",
  "type": "module",
  "engines": {
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build-server": "vite build --config vite-server.config.js",
    "package": "npm run build && npm run build-server && tar czf SpellCheckingPrototype.tar.gz .env.example dist server-dist",
    "preview": "vite preview",
    "server": "node --env-file=.env --disable-warning=ExperimentalWarning server/index.ts",
    "start": "npm run build && npm run server",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "eval": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning eval/spell-check.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
