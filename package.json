{
  "name": "spell-checking-prototype",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "description": "Demo of LLM spell checking, auto-correct, inline completion and polish for an agent message field",
  "type": "module",
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "eval": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning eval/spell-check.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
