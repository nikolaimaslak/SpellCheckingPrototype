dist/
coverage/

# Generated by fetch-dicts from node_modules/dictionary-en and dicts/ar
public/dicts/

# Hunspell WASM build workspace (outputs in src/spell/wasm/ ARE committed)
wasm/.build/

.DS_Store
*.log
.vite/

# Completion server: secrets and local telemetry log
.env
