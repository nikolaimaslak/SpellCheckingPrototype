# Evaluation: run reports, and private datasets that must never be committed
/eval/reports/
/eval/datasets/private/

# Obsidian vault settings (per-user editor state)
/.obsidian/

# Python server (uv): environment, caches, and the opt-in LLM request cache
server/.venv/
__pycache__/
.pytest_cache/
/.cache/

# Local completion eval workspace: inputs, generated sets, run reports (never committed)
/eval/local/

# Opt-in LLM capture log (ASSIST_CAPTURE): request and answer text, never committed
/capture/
