# Copy to .env (git-ignored) and adjust. Read by the completion server (npm run demo / npm run server).

# Google Gemini API key for live inline completion and grammar polish.
# Leave empty to use the offline test model (canned results, nothing leaves your machine).
# With a key, text typed in the demo composers is sent to Google: use made-up text only.
GEMINI_API_KEY=

# auto   = Gemini when GEMINI_API_KEY is set, otherwise the offline test model (default)
# gemini = Gemini only (completion and polish are unavailable without a key)
# fake   = offline test model only, even if a key is set
COMPLETION_MODEL=auto

# Safety filter for completions (formal Req 3.7: no personal data, identifiers, amounts, dates or timelines).
# block = withhold any completion with a number, amount, date or time period (default)
# allow = let figures and dates through when the whole completion is worded exactly as in an approved
#         canned response or knowledge-base passage. Identifiers and customer names are always withheld.
COMPLETION_SOURCED_FIGURES=block
