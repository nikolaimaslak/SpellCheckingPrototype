# Copy to .env (git-ignored) and adjust. Read by the completion server (npm run demo / npm run server).

# Google Gemini API key for live inline completion and grammar polish.
# Leave empty to use the offline test model (canned results, nothing leaves your machine).
# With a key, text typed in the demo composers is sent to Google: use made-up text only.
GEMINI_API_KEY=

# auto   = Gemini when GEMINI_API_KEY is set, otherwise the offline test model (default)
# gemini = Gemini only (completion and polish are unavailable without a key)
# fake   = offline test model only, even if a key is set
# <provider>/<model> = any model LiteLLM supports, for example a local one:
#          ollama_chat/qwen3:8b   (Ollama on this machine: typed text stays on this machine)
#          hosted_vllm/<model>    (with COMPLETION_API_BASE; text leaves the machine unless the base is localhost)
COMPLETION_MODEL=auto

# Where a provider-qualified model is reached, for example http://127.0.0.1:11434 for Ollama
# or http://localhost:8000/v1 for vLLM. Leave empty for the provider's default.
COMPLETION_API_BASE=

# How many of the most recent conversation turns completion sends to the model.
# Empty (default) = the full conversation.
COMPLETION_MAX_TURNS=

# off (default) or on. When on, every request sent to the model, including the
# conversation and the agent's text, is stored on disk under .cache/llm/
# (git-ignored), and identical requests are answered from there.
ASSIST_LLM_CACHE=off
